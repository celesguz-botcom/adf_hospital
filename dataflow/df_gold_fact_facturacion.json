{
	"name": "df_gold_fact_facturacion",
	"properties": {
		"folder": {
			"name": "df_gold"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_silver_facturacion",
						"type": "DatasetReference"
					},
					"name": "srcfacturacion"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_gold_fact_facturacion",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "alterRow1"
				},
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          billing_id_bk as integer,",
				"          admission_id_bk as integer,",
				"          paciente_key as integer,",
				"          departamento_key as integer,",
				"          servicio_cargo_key as integer,",
				"          fecha_pago_key as integer,",
				"          monto_facturado as decimal(12,2),",
				"          conteo_transacciones as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT\\n    b.billing_id AS billing_id_bk,\\n    b.admission_id AS admission_id_bk,\\n    p.paciente_key,\\n    d.departamento_key,\\n    s.servicio_cargo_key,\\n    f.fecha_key AS fecha_pago_key,\\n    b.amount AS monto_facturado,\\n    CAST(1 AS INT) AS conteo_transacciones\\nFROM silver.billing b\\nINNER JOIN silver.admissions a\\n    ON a.admission_id = b.admission_id\\nINNER JOIN gold.dim_paciente p\\n    ON p.patient_id_bk = a.patient_id\\nINNER JOIN gold.dim_departamento d\\n    ON d.nombre_departamento = a.department\\nINNER JOIN gold.dim_servicio_cargo s\\n    ON s.tipo_cargo = b.charge_type\\n    AND s.estado_pago = b.payment_status\\nINNER JOIN gold.dim_fecha f\\n    ON f.fecha_completa = b.payment_date',",
				"     format: 'query') ~> srcfacturacion",
				"derivedColumn1 alterRow(upsertIf(true())) ~> alterRow1",
				"srcfacturacion derive(conteo_transacciones = toInteger(1)) ~> derivedColumn1",
				"alterRow1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          facturacion_key as long,",
				"          billing_id_bk as integer,",
				"          admission_id_bk as integer,",
				"          paciente_key as integer,",
				"          departamento_key as integer,",
				"          servicio_cargo_key as integer,",
				"          fecha_pago_key as integer,",
				"          monto_facturado as decimal(12,2),",
				"          conteo_transacciones as integer",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:true,",
				"     keys:['billing_id_bk'],",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          billing_id_bk,",
				"          admission_id_bk,",
				"          paciente_key,",
				"          departamento_key,",
				"          servicio_cargo_key,",
				"          fecha_pago_key,",
				"          monto_facturado,",
				"          conteo_transacciones",
				"     )) ~> sink1"
			]
		}
	}
}