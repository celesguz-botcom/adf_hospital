{
	"name": "df_silver_admisiones",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_bronze_admisiones",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_silver_admisiones",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          admission_id as string,",
				"          patient_id as string,",
				"          admission_date as string,",
				"          discharge_date as string,",
				"          department as string,",
				"          attending_doctor_id as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(admission_date = iif(\r",
				"    isNull(admission_date) || trim(toString(admission_date)) == '',\r",
				"    toDate(null()),\r",
				"    iif(\r",
				"        regexMatch(toString(admission_date), '^[A-Za-z]+ [0-9]{1,2}, [0-9]{4}$'),\r",
				"        toDate(toString(admission_date), 'MMMM dd, yyyy'),\r",
				"        iif(\r",
				"            regexMatch(toString(admission_date), '^[0-9]{2}-[0-9]{2}-[0-9]{2}$'),\r",
				"            toDate(toString(admission_date), 'MM-dd-yy'),\r",
				"            iif(\r",
				"                regexMatch(toString(admission_date), '^[0-9]{2}-[A-Za-z]{3}-[0-9]{4}$'),\r",
				"                toDate(toString(admission_date), 'dd-MMM-yyyy'),\r",
				"                iif(\r",
				"                    regexMatch(toString(admission_date), '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'),\r",
				"                    toDate(toString(admission_date), 'yyyy-MM-dd'),\r",
				"                    toDate(toString(admission_date), 'MM/dd/yyyy')\r",
				"                )\r",
				"            )\r",
				"        )\r",
				"    )\r",
				"),",
				"          discharge_date = iif(\r",
				"    isNull(discharge_date) || trim(toString(discharge_date)) == '',\r",
				"    toDate(null()),\r",
				"    iif(\r",
				"        regexMatch(toString(discharge_date), '^[A-Za-z]+ [0-9]{1,2}, [0-9]{4}$'),\r",
				"        toDate(toString(discharge_date), 'MMMM dd, yyyy'),\r",
				"        iif(\r",
				"            regexMatch(toString(discharge_date), '^[0-9]{2}-[0-9]{2}-[0-9]{2}$'),\r",
				"            toDate(toString(discharge_date), 'MM-dd-yy'),\r",
				"            iif(\r",
				"                regexMatch(toString(discharge_date), '^[0-9]{2}-[A-Za-z]{3}-[0-9]{4}$'),\r",
				"                toDate(toString(discharge_date), 'dd-MMM-yyyy'),\r",
				"                iif(\r",
				"                    regexMatch(toString(discharge_date), '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'),\r",
				"                    toDate(toString(discharge_date), 'yyyy-MM-dd'),\r",
				"                    toDate(toString(discharge_date), 'MM/dd/yyyy')\r",
				"                )\r",
				"            )\r",
				"        )\r",
				"    )\r",
				"),",
				"          department = iif(\r",
				"    lower(trim(toString(department))) == 'onco' || lower(trim(toString(department))) == 'oncologyy',\r",
				"    'Oncology',\r",
				"    iif(\r",
				"        lower(trim(toString(department))) == 'cardio' || lower(trim(toString(department))) == 'cardiolgy',\r",
				"        'Cardiology',\r",
				"        iif(\r",
				"            lower(trim(toString(department))) == 'emergancy' || lower(trim(toString(department))) == 'er',\r",
				"            'Emergency',\r",
				"            iif(\r",
				"                lower(trim(toString(department))) == 'paediatrics' || lower(trim(toString(department))) == 'peds',\r",
				"                'Pediatrics',\r",
				"                iif(\r",
				"                    lower(trim(toString(department))) == 'ortho' || lower(trim(toString(department))) == 'orthopaedics',\r",
				"                    'Orthopedics',\r",
				"                    iif(\r",
				"                        lower(trim(toString(department))) == 'nuerology' || lower(trim(toString(department))) == 'neuro',\r",
				"                        'Neurology',\r",
				"                        iif(\r",
				"                            lower(replace(trim(toString(department)), ' ', '')) == 'gensurg' ||\r",
				"                            lower(replace(trim(toString(department)), ' ', '')) == 'generalsurgery',\r",
				"                            'General Surgery',\r",
				"                            initCap(trim(toString(department)))\r",
				"                        )\r",
				"                    )\r",
				"                )\r",
				"            )\r",
				"        )\r",
				"    )\r",
				")) ~> derivedColumn1",
				"derivedColumn1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          admission_id as integer,",
				"          patient_id as integer,",
				"          admission_date as date,",
				"          discharge_date as date,",
				"          department as string,",
				"          attending_doctor_id as integer",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
			]
		}
	}
}