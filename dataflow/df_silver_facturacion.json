{
	"name": "df_silver_facturacion",
	"properties": {
		"folder": {
			"name": "df_silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_bronze_facturacion",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_silver_facturacion",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "alterRow1"
				},
				{
					"name": "filter1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          billing_id as string,",
				"          admission_id as string,",
				"          charge_type as string,",
				"          amount as string,",
				"          payment_status as string,",
				"          payment_date as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT b.*\\nFROM bronze.billing b\\nWHERE EXISTS (\\n    SELECT 1\\n    FROM silver.admissions a\\n    WHERE a.admission_id = b.admission_id\\n)',",
				"     format: 'query') ~> source1",
				"source1 derive(charge_type = iif(\r",
				"    isNull(charge_type) || trim(toString(charge_type)) == '',\r",
				"    'Not Specified',\r",
				"    initCap(lower(trim(toString(charge_type))))\r",
				"),",
				"          amount = iif(\r",
				"    isNull(amount) || trim(toString(amount)) == '',\r",
				"    toDecimal(null()),\r",
				"    toDecimal(\r",
				"        replace(\r",
				"            replace(\r",
				"                replace(\r",
				"                    replace(trim(toString(amount)), 'USD', ''),\r",
				"                    '$',\r",
				"                    ''\r",
				"                ),\r",
				"                ',',\r",
				"                ''\r",
				"            ),\r",
				"            ' ',\r",
				"            ''\r",
				"        )\r",
				"    )\r",
				"),",
				"          payment_status = iif(\r",
				"    isNull(payment_status) || trim(toString(payment_status)) == '',\r",
				"    'Not Specified',\r",
				"    initCap(lower(trim(toString(payment_status))))\r",
				"),",
				"          payment_date = iif(\r",
				"    isNull(payment_date) || trim(toString(payment_date)) == '',\r",
				"    toDate(null()),\r",
				"    iif(\r",
				"        regexMatch(toString(payment_date), '^[A-Za-z]+ [0-9]{1,2}, [0-9]{4}$'),\r",
				"        toDate(toString(payment_date), 'MMMM dd, yyyy'),\r",
				"        iif(\r",
				"            regexMatch(toString(payment_date), '^[0-9]{1,2}-[A-Za-z]{3}-[0-9]{4}$'),\r",
				"            toDate(toString(payment_date), 'dd-MMM-yyyy'),\r",
				"            iif(\r",
				"                regexMatch(toString(payment_date), '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'),\r",
				"                toDate(toString(payment_date), 'yyyy-MM-dd'),\r",
				"                iif(\r",
				"                    regexMatch(toString(payment_date), '^[0-9]{2}/[0-9]{2}/[0-9]{4}$'),\r",
				"                    toDate(toString(payment_date), 'MM/dd/yyyy'),\r",
				"                    iif(\r",
				"                        regexMatch(toString(payment_date), '^[0-9]{2}-[0-9]{2}-[0-9]{2}$'),\r",
				"                        toDate(toString(payment_date), 'MM-dd-yy'),\r",
				"                        toDate(toString(payment_date), 'MM-dd-yyyy')\r",
				"                    )\r",
				"                )\r",
				"            )\r",
				"        )\r",
				"    )\r",
				")) ~> derivedColumn1",
				"filter1 alterRow(upsertIf(true())) ~> alterRow1",
				"derivedColumn1 filter(!isNull(amount)) ~> filter1",
				"alterRow1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          billing_id as integer,",
				"          admission_id as integer,",
				"          charge_type as string,",
				"          amount as decimal(12,2),",
				"          payment_status as string,",
				"          payment_date as date",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:true,",
				"     upsertable:true,",
				"     keys:['billing_id'],",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
			]
		}
	}
}