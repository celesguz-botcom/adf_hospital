{
	"name": "df_gold_dim_paciente",
	"properties": {
		"folder": {
			"name": "df_gold"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_silver_pacientes",
						"type": "DatasetReference"
					},
					"name": "srcpaciente"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_gold_dim_paciente",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "dercolumnaspaciente"
				}
			],
			"scriptLines": [
				"source(output(",
				"          patient_id as integer,",
				"          full_name as string,",
				"          gender as string,",
				"          date_of_birth as date,",
				"          phone as string,",
				"          email as string,",
				"          address as string,",
				"          insurance_provider as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> srcpaciente",
				"srcpaciente derive(patient_id_bk = toInteger(patient_id),",
				"          nombre_completo = toString(full_name),",
				"          genero = case(gender == 'Male', 'Masculino', gender == 'Female', 'Femenino', 'Otro'),",
				"          fecha_nacimiento = date_of_birth,",
				"          correo_electronico = toString(email),",
				"          direccion = toString(address),",
				"          proveedor_seguro = toString(insurance_provider),",
				"          rango_etario = case(\r",
				"    isNull(date_of_birth), 'Sin dato',\r",
				"    monthsBetween(currentDate(), date_of_birth) < 216, '0-17',\r",
				"    monthsBetween(currentDate(), date_of_birth) < 360, '18-29',\r",
				"    monthsBetween(currentDate(), date_of_birth) < 600, '30-49',\r",
				"    monthsBetween(currentDate(), date_of_birth) < 780, '50-64',\r",
				"    '65 o más'\r",
				")) ~> dercolumnaspaciente",
				"dercolumnaspaciente sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          paciente_key as integer,",
				"          patient_id_bk as integer,",
				"          nombre_completo as string,",
				"          genero as string,",
				"          fecha_nacimiento as date,",
				"          rango_etario as string,",
				"          correo_electronico as string,",
				"          direccion as string,",
				"          proveedor_seguro as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:true,",
				"     keys:['patient_id_bk'],",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          patient_id_bk,",
				"          nombre_completo,",
				"          genero,",
				"          fecha_nacimiento,",
				"          rango_etario,",
				"          correo_electronico,",
				"          direccion,",
				"          proveedor_seguro",
				"     )) ~> sink1"
			]
		}
	}
}