{
	"name": "df_silver_pacientes",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_bronze_pacientes",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_silver_pacientes",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "alterRow1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          patient_id as string,",
				"          full_name as string,",
				"          gender as string,",
				"          date_of_birth as string,",
				"          phone as string,",
				"          email as string,",
				"          address as string,",
				"          insurance_provider as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(gender = iif(lower(trim(gender)) == 'm' || lower(trim(gender)) == 'male',    'Male',    iif(        lower(trim(gender)) == 'f' || lower(trim(gender)) == 'female',        'Female',        'Other'    )),",
				"          full_name = iif(\r",
				"    isNull(full_name) || trim(toString(full_name)) == '',\r",
				"    toString(null()),\r",
				"    regexReplace(trim(toString(full_name)), 'Ã‚+$', '')\r",
				"),",
				"          date_of_birth = iif(\r",
				"    isNull(date_of_birth) || trim(toString(date_of_birth)) == '',\r",
				"    toDate(null()),\r",
				"    iif(\r",
				"        regexMatch(toString(date_of_birth), '^[A-Za-z]+ [0-9]{1,2}, [0-9]{4}$'),\r",
				"        toDate(toString(date_of_birth), 'MMMM dd, yyyy'),\r",
				"        iif(\r",
				"            regexMatch(toString(date_of_birth), '^[0-9]{2}-[0-9]{2}-[0-9]{2}$'),\r",
				"            toDate(toString(date_of_birth), 'MM-dd-yy'),\r",
				"            iif(\r",
				"                regexMatch(toString(date_of_birth), '^[0-9]{2}-[A-Za-z]{3}-[0-9]{4}$'),\r",
				"                toDate(toString(date_of_birth), 'dd-MMM-yyyy'),\r",
				"                iif(\r",
				"                    regexMatch(toString(date_of_birth), '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'),\r",
				"                    toDate(toString(date_of_birth), 'yyyy-MM-dd'),\r",
				"                    toDate(toString(date_of_birth), 'MM/dd/yyyy')\r",
				"                )\r",
				"            )\r",
				"        )\r",
				"    )\r",
				")) ~> derivedColumn1",
				"derivedColumn1 derive(phone = iif(\r",
				"    isNull(phone) || lower(trim(toString(phone))) == '' ||\r",
				"    lower(trim(toString(phone))) == 'unknown' ||\r",
				"    lower(trim(toString(phone))) == 'n/a',\r",
				"    toString(null()),\r",
				"    regexReplace(trim(toString(phone)), '[^0-9+]', '')\r",
				"),",
				"          email = iif(\r",
				"    isNull(email) || trim(toString(email)) == '' ||\r",
				"    lower(trim(toString(email))) == 'unknown' ||\r",
				"    lower(trim(toString(email))) == 'n/a',\r",
				"    toString(null()),\r",
				"    lower(\r",
				"        replace(\r",
				"            replace(\r",
				"                replace(\r",
				"                    replace(trim(toString(email)), ' at ', '@'),\r",
				"                    ',',\r",
				"                    '.'\r",
				"                ),\r",
				"                ' ',\r",
				"                ''\r",
				"            ),\r",
				"            'gmial.com',\r",
				"            'gmail.com'\r",
				"        )\r",
				"    )\r",
				"),",
				"          address = iif(\r",
				"    isNull(address) || trim(toString(address)) == '',\r",
				"    toString(null()),\r",
				"    trim(toString(address))\r",
				"),",
				"          insurance_provider = iif(\r",
				"    isNull(insurance_provider) ||\r",
				"    trim(toString(insurance_provider)) == '' ||\r",
				"    lower(trim(toString(insurance_provider))) == 'unknown' ||\r",
				"    lower(trim(toString(insurance_provider))) == 'n/a',\r",
				"    'Not Specified',\r",
				"    iif(\r",
				"        lower(replace(replace(replace(trim(toString(insurance_provider)), '-', ''), ' ', ''), '.', '')) == 'bluecross',\r",
				"        'Blue Cross',\r",
				"        iif(\r",
				"            lower(replace(replace(replace(trim(toString(insurance_provider)), '-', ''), ' ', ''), '.', '')) == 'medicare',\r",
				"            'Medicare',\r",
				"            iif(\r",
				"                lower(replace(replace(replace(trim(toString(insurance_provider)), '-', ''), ' ', ''), '.', '')) == 'unitedhealth' ||\r",
				"                lower(replace(replace(replace(trim(toString(insurance_provider)), '-', ''), ' ', ''), '.', '')) == 'uhc',\r",
				"                'United Health',\r",
				"                iif(\r",
				"    lower(replace(replace(replace(trim(toString(insurance_provider)), '-', ''), ' ', ''), '.', '')) == 'selfpay',\r",
				"    'Self Pay',\r",
				"    initCap(trim(toString(insurance_provider)))\r",
				")\r",
				"            )\r",
				"        )\r",
				"    )\r",
				")) ~> derivedColumn2",
				"derivedColumn2 alterRow(upsertIf(true())) ~> alterRow1",
				"alterRow1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          patient_id as integer,",
				"          full_name as string,",
				"          gender as string,",
				"          date_of_birth as date,",
				"          phone as string,",
				"          email as string,",
				"          address as string,",
				"          insurance_provider as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:true,",
				"     upsertable:true,",
				"     keys:['patient_id'],",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
			]
		}
	}
}