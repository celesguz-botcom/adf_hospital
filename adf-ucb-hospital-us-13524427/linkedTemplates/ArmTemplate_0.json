		{
			"name": "[concat(parameters('factoryName'), '/df_gold_dim_fecha')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"folder": {
					"name": "df_gold"
				},
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "ds_silver_admisiones",
								"type": "DatasetReference"
							},
							"name": "srccalendario"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "ds_gold_dim_fecha",
								"type": "DatasetReference"
							},
							"name": "sink1"
						}
					],
					"transformations": [
						{
							"name": "dercolumnasfecha"
						}
					],
					"scriptLines": [
						"source(output(",
						"          fecha_completa as date",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     query: '\\nSELECT\\n    DATEADD(\\n        DAY,\\n        ROW_NUMBER() OVER (ORDER BY (SELECT NULL)) - 1,\\n        CAST(\\'2023-01-01\\' AS DATE)\\n    ) AS fecha_completa\\nFROM sys.all_objects a\\nCROSS JOIN sys.all_objects b\\n',",
						"     format: 'query') ~> srccalendario",
						"srccalendario derive(fecha_key = toInteger(toString(fecha_completa, 'yyyyMMdd')),",
						"          anio = toShort(year(fecha_completa)),",
						"          trimestre = toByte(ceil(month(fecha_completa) / 3.0)),",
						"          trimestre_nombre = case(\r",
						"    month(fecha_completa) <= 3, 'T1',\r",
						"    month(fecha_completa) <= 6, 'T2',\r",
						"    month(fecha_completa) <= 9, 'T3',\r",
						"    'T4'\r",
						"),",
						"          mes = toByte(month(fecha_completa)),",
						"          mes_nombre = case(\r",
						"    month(fecha_completa) == 1, 'Enero',\r",
						"    month(fecha_completa) == 2, 'Febrero',\r",
						"    month(fecha_completa) == 3, 'Marzo',\r",
						"    month(fecha_completa) == 4, 'Abril',\r",
						"    month(fecha_completa) == 5, 'Mayo',\r",
						"    month(fecha_completa) == 6, 'Junio',\r",
						"    month(fecha_completa) == 7, 'Julio',\r",
						"    month(fecha_completa) == 8, 'Agosto',\r",
						"    month(fecha_completa) == 9, 'Septiembre',\r",
						"    month(fecha_completa) == 10, 'Octubre',\r",
						"    month(fecha_completa) == 11, 'Noviembre',\r",
						"    'Diciembre'\r",
						"),",
						"          mes_corto = case(\r",
						"    month(fecha_completa) == 1, 'Ene',\r",
						"    month(fecha_completa) == 2, 'Feb',\r",
						"    month(fecha_completa) == 3, 'Mar',\r",
						"    month(fecha_completa) == 4, 'Abr',\r",
						"    month(fecha_completa) == 5, 'May',\r",
						"    month(fecha_completa) == 6, 'Jun',\r",
						"    month(fecha_completa) == 7, 'Jul',\r",
						"    month(fecha_completa) == 8, 'Ago',\r",
						"    month(fecha_completa) == 9, 'Sep',\r",
						"    month(fecha_completa) == 10, 'Oct',\r",
						"    month(fecha_completa) == 11, 'Nov',\r",
						"    'Dic'\r",
						"),",
						"          semana_anio = toByte(weekOfYear(fecha_completa)),",
						"          dia_mes = toByte(dayOfMonth(fecha_completa)),",
						"          dia_semana = toByte(mod(dayOfWeek(fecha_completa) + 5, 7) + 1),",
						"          dia_nombre = case(\r",
						"    dayOfWeek(fecha_completa) == 1, 'Domingo',\r",
						"    dayOfWeek(fecha_completa) == 2, 'Lunes',\r",
						"    dayOfWeek(fecha_completa) == 3, 'Martes',\r",
						"    dayOfWeek(fecha_completa) == 4, 'Miercoles',\r",
						"    dayOfWeek(fecha_completa) == 5, 'Jueves',\r",
						"    dayOfWeek(fecha_completa) == 6, 'Viernes',\r",
						"    'Sabado'\r",
						"),",
						"          es_fin_de_semana = dayOfWeek(fecha_completa) == 1 || dayOfWeek(fecha_completa) == 7) ~> dercolumnasfecha",
						"dercolumnasfecha sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          fecha_key as integer,",
						"          fecha_completa as date,",
						"          anio as integer,",
						"          trimestre as integer,",
						"          trimestre_nombre as string,",
						"          mes as integer,",
						"          mes_nombre as string,",
						"          mes_corto as string,",
						"          semana_anio as integer,",
						"          dia_mes as integer,",
						"          dia_semana as integer,",
						"          dia_nombre as string,",
						"          es_fin_de_semana as boolean",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/ds_silver_admisiones')]",
				"[concat(variables('factoryId'), '/datasets/ds_gold_dim_fecha')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/df_silver_admisiones')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"folder": {
					"name": "df_silver"
				},
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "ds_bronze_admisiones",
								"type": "DatasetReference"
							},
							"name": "source1"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "ds_silver_admisiones",
								"type": "DatasetReference"
							},
							"name": "sink1"
						}
					],
					"transformations": [
						{
							"name": "derivedColumn1"
						},
						{
							"name": "alterRow1"
						}
					],
					"scriptLines": [
						"source(output(",
						"          admission_id as string,",
						"          patient_id as string,",
						"          admission_date as string,",
						"          discharge_date as string,",
						"          department as string,",
						"          attending_doctor_id as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     query: 'SELECT a.*\\nFROM bronze.admissions a\\nWHERE EXISTS (\\n    SELECT 1\\n    FROM silver.patients p\\n    WHERE p.patient_id = a.patient_id\\n)',",
						"     format: 'query') ~> source1",
						"source1 derive(admission_date = iif(\r",
						"    isNull(admission_date) || trim(toString(admission_date)) == '',\r",
						"    toDate(null()),\r",
						"    iif(\r",
						"        regexMatch(toString(admission_date), '^[A-Za-z]+ [0-9]{1,2}, [0-9]{4}$'),\r",
						"        toDate(toString(admission_date), 'MMMM dd, yyyy'),\r",
						"        iif(\r",
						"            regexMatch(toString(admission_date), '^[0-9]{2}-[0-9]{2}-[0-9]{2}$'),\r",
						"            toDate(toString(admission_date), 'MM-dd-yy'),\r",
						"            iif(\r",
						"                regexMatch(toString(admission_date), '^[0-9]{2}-[A-Za-z]{3}-[0-9]{4}$'),\r",
						"                toDate(toString(admission_date), 'dd-MMM-yyyy'),\r",
						"                iif(\r",
						"                    regexMatch(toString(admission_date), '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'),\r",
						"                    toDate(toString(admission_date), 'yyyy-MM-dd'),\r",
						"                    toDate(toString(admission_date), 'MM/dd/yyyy')\r",
						"                )\r",
						"            )\r",
						"        )\r",
						"    )\r",
						"),",
						"          discharge_date = iif(\r",
						"    isNull(discharge_date) || trim(toString(discharge_date)) == '',\r",
						"    toDate(null()),\r",
						"    iif(\r",
						"        regexMatch(toString(discharge_date), '^[A-Za-z]+ [0-9]{1,2}, [0-9]{4}$'),\r",
						"        toDate(toString(discharge_date), 'MMMM dd, yyyy'),\r",
						"        iif(\r",
						"            regexMatch(toString(discharge_date), '^[0-9]{2}-[0-9]{2}-[0-9]{2}$'),\r",
						"            toDate(toString(discharge_date), 'MM-dd-yy'),\r",
						"            iif(\r",
						"                regexMatch(toString(discharge_date), '^[0-9]{2}-[A-Za-z]{3}-[0-9]{4}$'),\r",
						"                toDate(toString(discharge_date), 'dd-MMM-yyyy'),\r",
						"                iif(\r",
						"                    regexMatch(toString(discharge_date), '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'),\r",
						"                    toDate(toString(discharge_date), 'yyyy-MM-dd'),\r",
						"                    toDate(toString(discharge_date), 'MM/dd/yyyy')\r",
						"                )\r",
						"            )\r",
						"        )\r",
						"    )\r",
						"),",
						"          department = iif(\r",
						"    lower(trim(toString(department))) == 'onco' || lower(trim(toString(department))) == 'oncologyy',\r",
						"    'Oncology',\r",
						"    iif(\r",
						"        lower(trim(toString(department))) == 'cardio' || lower(trim(toString(department))) == 'cardiolgy',\r",
						"        'Cardiology',\r",
						"        iif(\r",
						"            lower(trim(toString(department))) == 'emergancy' || lower(trim(toString(department))) == 'er',\r",
						"            'Emergency',\r",
						"            iif(\r",
						"                lower(trim(toString(department))) == 'paediatrics' || lower(trim(toString(department))) == 'peds',\r",
						"                'Pediatrics',\r",
						"                iif(\r",
						"                    lower(trim(toString(department))) == 'ortho' || lower(trim(toString(department))) == 'orthopaedics',\r",
						"                    'Orthopedics',\r",
						"                    iif(\r",
						"                        lower(trim(toString(department))) == 'nuerology' || lower(trim(toString(department))) == 'neuro',\r",
						"                        'Neurology',\r",
						"                        iif(\r",
						"                            lower(replace(trim(toString(department)), ' ', '')) == 'gensurg' ||\r",
						"                            lower(replace(trim(toString(department)), ' ', '')) == 'generalsurgery',\r",
						"                            'General Surgery',\r",
						"                            initCap(trim(toString(department)))\r",
						"                        )\r",
						"                    )\r",
						"                )\r",
						"            )\r",
						"        )\r",
						"    )\r",
						")) ~> derivedColumn1",
						"derivedColumn1 alterRow(upsertIf(true())) ~> alterRow1",
						"alterRow1 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          admission_id as integer,",
						"          patient_id as integer,",
						"          admission_date as date,",
						"          discharge_date as date,",
						"          department as string,",
						"          attending_doctor_id as integer",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:true,",
						"     upsertable:true,",
						"     keys:['admission_id'],",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/ds_bronze_admisiones')]",
				"[concat(variables('factoryId'), '/datasets/ds_silver_admisiones')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/df_silver_diagnosticos')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"folder": {
					"name": "df_silver"
				},
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "ds_bronze_diagnosticos",
								"type": "DatasetReference"
							},
							"name": "source1"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "ds_silver_diagnosticos",
								"type": "DatasetReference"
							},
							"name": "sink1"
						}
					],
					"transformations": [
						{
							"name": "derivedColumn1"
						},
						{
							"name": "derivedColumn2"
						},
						{
							"name": "alterRow1"
						}
					],
					"scriptLines": [
						"source(output(",
						"          diagnosis_id as string,",
						"          admission_id as string,",
						"          icd_code as string,",
						"          diagnosis_description as string,",
						"          severity as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     query: 'SELECT d.*\\nFROM bronze.diagnoses d\\nWHERE EXISTS (\\n    SELECT 1\\n    FROM silver.admissions a\\n    WHERE a.admission_id = d.admission_id\\n)',",
						"     format: 'query') ~> source1",
						"source1 derive(icd_code = iif(\r",
						"    isNull(icd_code) || trim(toString(icd_code)) == '',\r",
						"    toString(null()),\r",
						"    upper(\r",
						"        replace(\r",
						"            replace(\r",
						"                replace(trim(toString(icd_code)), ' ', ''),\r",
						"                '-',\r",
						"                '.'\r",
						"            ),\r",
						"            ',',\r",
						"            ', '\r",
						"        )\r",
						"    )\r",
						")) ~> derivedColumn1",
						"derivedColumn1 derive(icd_code = replace(\r",
						"    replace(\r",
						"        replace(\r",
						"            replace(\r",
						"                replace(\r",
						"                    replace(\r",
						"                        replace(\r",
						"                            replace(toString(icd_code), 'M545', 'M54.5'),\r",
						"                            'N390', 'N39.0'\r",
						"                        ),\r",
						"                        'F329', 'F32.9'\r",
						"                    ),\r",
						"                    'J45909', 'J45.909'\r",
						"                ),\r",
						"                'C50911', 'C50.911'\r",
						"            ),\r",
						"            'E119', 'E11.9'\r",
						"        ),\r",
						"        'K219', 'K21.9'\r",
						"    ),\r",
						"    'S72001A', 'S72.001A'\r",
						"),",
						"          diagnosis_description = iif(\r",
						"    isNull(diagnosis_description) || trim(toString(diagnosis_description)) == '',\r",
						"    toString(null()),\r",
						"    trim(toString(diagnosis_description))\r",
						"),",
						"          severity = iif(\r",
						"    isNull(severity) || trim(toString(severity)) == '',\r",
						"    toString(null()),\r",
						"    initCap(lower(trim(toString(severity))))\r",
						")) ~> derivedColumn2",
						"derivedColumn2 alterRow(upsertIf(true())) ~> alterRow1",
						"alterRow1 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          diagnosis_id as integer,",
						"          admission_id as integer,",
						"          icd_code as string,",
						"          diagnosis_description as string,",
						"          severity as string",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:true,",
						"     upsertable:true,",
						"     keys:['diagnosis_id'],",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/ds_bronze_diagnosticos')]",
				"[concat(variables('factoryId'), '/datasets/ds_silver_diagnosticos')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/df_silver_facturacion')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
