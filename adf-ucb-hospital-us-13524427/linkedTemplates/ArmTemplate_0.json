						"                    toDate(toString(date_of_birth), 'yyyy-MM-dd'),\r",
						"                    toDate(toString(date_of_birth), 'MM/dd/yyyy')\r",
						"                )\r",
						"            )\r",
						"        )\r",
						"    )\r",
						")) ~> derivedColumn1",
						"derivedColumn1 derive(phone = iif(\r",
						"    isNull(phone) || lower(trim(toString(phone))) == '' ||\r",
						"    lower(trim(toString(phone))) == 'unknown' ||\r",
						"    lower(trim(toString(phone))) == 'n/a',\r",
						"    toString(null()),\r",
						"    regexReplace(trim(toString(phone)), '[^0-9+]', '')\r",
						"),",
						"          email = iif(\r",
						"    isNull(email) || trim(toString(email)) == '' ||\r",
						"    lower(trim(toString(email))) == 'unknown' ||\r",
						"    lower(trim(toString(email))) == 'n/a',\r",
						"    toString(null()),\r",
						"    lower(\r",
						"        replace(\r",
						"            replace(\r",
						"                replace(\r",
						"                    replace(trim(toString(email)), ' at ', '@'),\r",
						"                    ',',\r",
						"                    '.'\r",
						"                ),\r",
						"                ' ',\r",
						"                ''\r",
						"            ),\r",
						"            'gmial.com',\r",
						"            'gmail.com'\r",
						"        )\r",
						"    )\r",
						"),",
						"          address = iif(\r",
						"    isNull(address) || trim(toString(address)) == '',\r",
						"    toString(null()),\r",
						"    trim(toString(address))\r",
						"),",
						"          insurance_provider = iif(\r",
