						"    trim(toString(insurance_provider)) == '' ||\r",
						"    lower(trim(toString(insurance_provider))) == 'unknown' ||\r",
						"    lower(trim(toString(insurance_provider))) == 'n/a',\r",
						"    'Not Specified',\r",
						"    iif(\r",
						"        lower(replace(replace(replace(trim(toString(insurance_provider)), '-', ''), ' ', ''), '.', '')) == 'bluecross',\r",
						"        'Blue Cross',\r",
						"        iif(\r",
						"            lower(replace(replace(replace(trim(toString(insurance_provider)), '-', ''), ' ', ''), '.', '')) == 'medicare',\r",
						"            'Medicare',\r",
						"            iif(\r",
						"                lower(replace(replace(replace(trim(toString(insurance_provider)), '-', ''), ' ', ''), '.', '')) == 'unitedhealth' ||\r",
						"                lower(replace(replace(replace(trim(toString(insurance_provider)), '-', ''), ' ', ''), '.', '')) == 'uhc',\r",
						"                'United Health',\r",
						"                iif(\r",
						"    lower(replace(replace(replace(trim(toString(insurance_provider)), '-', ''), ' ', ''), '.', '')) == 'selfpay',\r",
						"    'Self Pay',\r",
						"    initCap(trim(toString(insurance_provider)))\r",
						")\r",
						"            )\r",
						"        )\r",
						"    )\r",
						")) ~> derivedColumn2",
						"derivedColumn2 alterRow(upsertIf(true())) ~> alterRow1",
						"alterRow1 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          patient_id as integer,",
						"          full_name as string,",
						"          gender as string,",
						"          date_of_birth as date,",
						"          phone as string,",
						"          email as string,",
						"          address as string,",
						"          insurance_provider as string",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:true,",
						"     upsertable:true,",
						"     keys:['patient_id'],",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
					]
				}
